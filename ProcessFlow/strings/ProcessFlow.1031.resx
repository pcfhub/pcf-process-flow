<?xml version="1.0" encoding="utf-8"?>
<root>
  <!--
    Display names and descriptions for everything declared in
    ControlManifest.Input.xml. PCFHub reads the manifest, so these strings are
    what appear in the component's API reference on the hub as well as in the
    maker's properties pane.

    Copy this file to add a language — ProcessFlow.3082.resx for Spanish, and so
    on — then list it under <resources> in the manifest.
  -->
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="metadata">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" />
              </xsd:sequence>
              <xsd:attribute name="name" use="required" type="xsd:string" />
              <xsd:attribute name="type" type="xsd:string" />
              <xsd:attribute name="mimetype" type="xsd:string" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="assembly">
            <xsd:complexType>
              <xsd:attribute name="alias" type="xsd:string" />
              <xsd:attribute name="name" type="xsd:string" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" msdata:Ordinal="1" />
              <xsd:attribute name="type" type="xsd:string" msdata:Ordinal="3" />
              <xsd:attribute name="mimetype" type="xsd:string" msdata:Ordinal="4" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <data name="ProcessFlow_Name" xml:space="preserve">
    <value>Prozessfluss</value>
  </data>
  <data name="ProcessFlow_Desc" xml:space="preserve">
    <value>Eine Auswahlspalte als Statusleiste eines Geschäftsprozessflusses.</value>
  </data>
  <data name="Value_Name" xml:space="preserve">
    <value>Wert</value>
  </data>
  <data name="Value_Desc" xml:space="preserve">
    <value>Die Auswahlspalte (einfach oder Mehrfachauswahl), die dieses Steuerelement liest und schreibt. Die Reihenfolge ihrer Optionen ist die Reihenfolge der Schritte.</value>
  </data>
  <data name="Options_Name" xml:space="preserve">
    <value>Optionen</value>
  </data>
  <data name="Options_Desc" xml:space="preserve">
    <value>Überschreibt die Spaltenoptionen. JSON oder die Kurzform 1:Qualifizieren:#E8502A, 2:Entwickeln. In Canvas-Apps erforderlich, da diese keine Spaltenmetadaten veröffentlichen.</value>
  </data>
  <data name="Exclude_Name" xml:space="preserve">
    <value>Ausgeblendete Schritte</value>
  </data>
  <data name="Exclude_Desc" xml:space="preserve">
    <value>Optionen, die nicht auf der Leiste erscheinen, durch Kommas getrennt. Akzeptiert Werte oder Bezeichnungen. Eine ausgeblendete Option, die ein Datensatz bereits enthält, bleibt erhalten und wird nicht gelöscht.</value>
  </data>
  <data name="DefaultColor_Name" xml:space="preserve">
    <value>Standardfarbe</value>
  </data>
  <data name="DefaultColor_Desc" xml:space="preserve">
    <value>Die Farbe für eine Option, deren Metadaten keine enthalten. Standardmäßig das Orange des Geschäftsprozessflusses.</value>
  </data>
  <data name="ProcessFlow_NoAccess" xml:space="preserve">
    <value>Sie haben keinen Zugriff auf diesen Wert.</value>
  </data>
  <data name="ProcessFlow_NoSteps" xml:space="preserve">
    <value>Keine Schritte vorhanden.</value>
  </data>
  <data name="ProcessFlow_NoStage" xml:space="preserve">
    <value>Keine Phase erreicht</value>
  </data>
  <data name="ProcessFlow_StateDone" xml:space="preserve">
    <value>abgeschlossen</value>
  </data>
  <data name="ProcessFlow_StateCurrent" xml:space="preserve">
    <value>aktuelle Phase</value>
  </data>
  <data name="ProcessFlow_StateFuture" xml:space="preserve">
    <value>nicht erreicht</value>
  </data>
</root>
